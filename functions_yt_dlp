#!/bin/bash

function yt_audio() {
	if [ -z "$(which yt-dlp)" ]; then
		echo "yt-dlp has not been installed"
		return
	fi
	if [ -z "$(which gum)" ]; then
		echo "gum has not been installed"
		return
	fi

	local link output_filename

	link=$(gum input --header "Enter the YouTube link")
	if [ -z "$link" ]; then
		echo No link entered
		return
	fi

	local base query v_value
	base="${link%%\?*}"
	query="${link#*\?}"
	v_value="$(printf '%s' "$query" | tr '&' '\n' | grep '^v=' | head -1 | cut -d= -f2-)"
	if [ -n "$v_value" ]; then
		link="${base}?v=${v_value}"
	fi

	output_filename=$(gum input --header "Enter the output filename" --value="output.mp3")
	if [ -z "$output_filename" ]; then
		echo No filename entered
		return
	fi

	if [[ "$output_filename" != *.* ]]; then
		output_filename="${output_filename}.mp3"
	fi

	yt-dlp --extract-audio --audio-format mp3 "$link" -o "$output_filename"
}